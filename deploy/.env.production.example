# Copie para .env.production, fora do controle de versão. Sem valores padrão secretos.
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=
# Preserve a chave original da instalação para abrir os A1 já cifrados.
CERTIFICATE_ENCRYPTION_KEY=
DJANGO_ALLOWED_HOSTS=fiscal.seu-dominio.com,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://fiscal.seu-dominio.com
VINDEX_TRUST_PROXY=1
VINDEX_REGISTRATION_MODE=approval
VINDEX_DB_ENGINE=postgresql
PGHOST=db
PGPORT=5432
PGDATABASE=vindex
PGUSER=vindex
PGPASSWORD=
# Mesmo valor privado de PGPASSWORD para inicialização do contêiner PostgreSQL.
POSTGRES_PASSWORD=
# Rede interna do Compose. Para PostgreSQL externo, use require/verify-full.
PGSSLMODE=disable
VINDEX_REDIS_URL=redis://redis:6379/0
DJANGO_EMAIL_HOST=
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_USER=
DJANGO_EMAIL_PASSWORD=
DJANGO_EMAIL_TLS=1
DJANGO_DEFAULT_FROM_EMAIL=
# Espera após fim da fila/bloqueio. Mínimo efetivo: 61 minutos.
FISCAL_IDLE_INTERVAL_MINUTES=120
