# Copie para /etc/vindex/vindex.env (chmod 600). Nunca adicione segredos ao Git.
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=
# Copie EXATAMENTE a chave original do computador para manter os A1 legíveis.
CERTIFICATE_ENCRYPTION_KEY=
DJANGO_ALLOWED_HOSTS=fiscal.seu-dominio.com,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://fiscal.seu-dominio.com
VINDEX_TRUST_PROXY=1
VINDEX_REGISTRATION_MODE=approval
VINDEX_DB_ENGINE=sqlite
VINDEX_SQLITE_PATH=/var/lib/vindex/data/dados.sqlite3
VINDEX_RUNTIME_DIR=/var/lib/vindex/runtime
VINDEX_STATIC_ROOT=/var/lib/vindex/static
VINDEX_BACKUP_DIR=/var/backups/vindex
VINDEX_WEB_PORT=8000
VINDEX_REDIS_URL=redis://127.0.0.1:6379/0
FISCAL_IDLE_INTERVAL_MINUTES=120
DJANGO_EMAIL_HOST=
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_USER=
DJANGO_EMAIL_PASSWORD=
DJANGO_EMAIL_TLS=1
DJANGO_DEFAULT_FROM_EMAIL=
